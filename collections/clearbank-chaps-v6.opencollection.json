            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/chaps/v6/institution-payments",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "DigitalSignature",
                "value": ""
              },
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
