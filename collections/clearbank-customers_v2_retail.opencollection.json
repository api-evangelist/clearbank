        {
          "info": {
            "name": "Removes a related party link between two customers.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/customers/v2/customers/:customerId/related-parties/:relatedCustomerId/:relatedPartyType",
