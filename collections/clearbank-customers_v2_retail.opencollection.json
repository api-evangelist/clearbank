          "info": {
            "name": "Retrieves a customer by their customer ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/customers/v2/customers/:customerId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "DigitalSignature",
                "value": ""
              },
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The ID of the customer."
              }
            ]
          },
          "docs": "Retrieves a customer by their customer ID."
        },
        {
